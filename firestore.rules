rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidInspectionReport(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.date is string && data.date.size() <= 64 &&
             data.store is string && data.store.size() <= 256 &&
             data.nik is string && data.nik.size() <= 64 &&
             data.complianceScore is number &&
             data.complianceScore >= 0 && data.complianceScore <= 100;
    }

    // Koleksi Laporan Hasil Inspeksi LP
    match /inspection_reports/{reportId} {
      allow get, list: if true;
      allow create, update: if isValidId(reportId) && isValidInspectionReport(incoming());
      allow delete: if true;
    }

    // Uji Konektivitas Database saat Bootstrapping
    match /test/{docId} {
      allow read, write: if true;
    }

    // Pengaturan Sistem & Konfigurasi Google Drive Bersama
    match /system_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
